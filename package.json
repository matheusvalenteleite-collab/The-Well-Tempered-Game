{
  "name": "the-well-tempered-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A game for learning and practising species counterpoint.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "data:fetch": "tools/fux_import/fetch_source.sh",
    "data:build": "python3 tools/fux_import/build_dataset.py",
    "data:validate": "python3 tools/fux_import/validate.py",
    "data": "npm run data:build && npm run data:validate",
    "chorales:fetch": "tools/chorales/fetch_bach.sh",
    "chorales:bach": "python3 tools/chorales/bach_import.py && python3 tools/chorales/bach_validate.py",
    "chorales:kittel": "python3 tools/chorales/kittel_extract.py && python3 tools/chorales/kittel_check.py",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "report:m1": "node tools/m1/report.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.4.1",
    "typescript": "^5.8.3",
    "vite": "6.3.5"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "smplr": "0.16.4",
    "vexflow": "4.2.5"
  }
}
