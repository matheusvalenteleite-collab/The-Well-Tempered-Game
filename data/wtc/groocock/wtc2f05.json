 "claims": [
  {
   "page": 127,
   "claim": "'Without question the most close-knit fugue of the entire collection': 23 complete entries, all episodes and codettas from the second half of the subject"
  },
  {
   "page": 127,
   "claim": "Subject figure present in every bar except 3, 27, 43"
  },
  {
   "page": 128,
   "claim": "From bar 27 the subject-answer relationship is discontinued"
  },
  {
   "page": 129,
   "claim": "Bar 40 entry might serve as the final entry"
  },
  {
   "page": 129,
   "claim": "All previous stretti use two or three voices; stretto 6 uses all four"
  },
  {
   "page": 129,
   "claim": "Basic pattern answer-subject (as II.9) varied by subject-answer; 14 overlapping pairs: fifth lower/fourth higher 2 crotchets 5; fifth higher/fourth lower 4 crotchets 2; octave higher 1 crotchet 1; sixth higher/third lower 1 crotchet 5; seventh lower 3 crotchets 1"
  }
 ],
